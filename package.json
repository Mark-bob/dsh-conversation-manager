{
  "name": "@local/dsh-conversation-cleaner",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugin: manage conversations (archive, pin-lock, delete) and clean orphan attachments.",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "conversation"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node test/cleaner.test.mjs && node test/client.test.mjs",
    "verify": "npm run check && npm test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
